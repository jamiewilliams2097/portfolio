---
import BaseLayout from './BaseLayout.astro';
import ContactCTA from '../components/ContactCTA.astro';
import { Image } from 'astro:assets';
import { site } from '../data/site';
import { getAdjacent } from '../data/projects';
import type { Project } from '../data/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { prev, next } = getAdjacent(project.slug);

const canonical = new URL(`/work/${project.slug}`, site.url).toString();
const fullPoster = project.poster.startsWith('http')
  ? project.poster
  : new URL(project.poster, site.url).toString();
const description = `${project.title} — ${project.summary} A case study by ${site.name}.`;

const videoSchema = {
  '@context': 'https://schema.org',
  '@type': 'VideoObject',
  name: `${project.title} — ${project.client}`,
  description: project.summary,
  thumbnailUrl: [fullPoster],
  uploadDate: `${project.yearSort}-01-01`,
  contentUrl: `https://vimeo.com/${project.vimeoId}`,
  embedUrl: `https://player.vimeo.com/video/${project.vimeoId}`,
  publisher: {
    '@type': 'Person',
    name: site.fullName,
    url: site.url,
  },
  author: {
    '@type': 'Person',
    name: site.fullName,
    url: site.url,
  },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: site.url },
    { '@type': 'ListItem', position: 2, name: 'Work', item: new URL('/work', site.url).toString() },
    { '@type': 'ListItem', position: 3, name: project.title, item: canonical },
  ],
};
---

<BaseLayout
  title={`${project.title} — ${site.name}`}
  description={description}
  ogImage={project.poster}
  ogType="article"
  canonical={canonical}
  structuredData={[videoSchema, breadcrumbSchema]}
>
  <article class="px-6 pb-20 pt-32 sm:px-12 sm:pb-32 sm:pt-40">
    <div class="mx-auto max-w-screen-2xl">
      <!-- Title bar -->
      <header class="reveal">
        <nav aria-label="Breadcrumb" class="text-[10px] uppercase tracking-[0.3em] text-paper/40">
          <a href="/work" class="transition hover:text-paper">Work</a>
          <span class="mx-2 text-paper/20" aria-hidden="true">/</span>
          <span>{project.sector}</span>
        </nav>

        <h1 class="mt-6 max-w-5xl text-5xl font-medium leading-[1.02] tracking-[-0.03em] sm:text-7xl md:text-8xl">
          {project.title}<span class="text-accent">.</span>
        </h1>

        <p class="mt-6 max-w-3xl text-lg font-light text-paper/75 sm:text-xl md:text-2xl">
          {project.summary}
        </p>
      </header>

      <!-- Hero embed -->
      <div class="reveal reveal-d1 mt-12 sm:mt-16">
        <button
          type="button"
          data-lightbox-open
          data-vimeo-id={project.vimeoId}
          class="group relative block w-full overflow-hidden rounded-sm"
          aria-label={`Play ${project.title}`}
          data-event="project_play"
          data-project={project.slug}
        >
          <div class="video-frame">
            <Image
              src={project.poster}
              alt={`${project.title} — ${project.client}`}
              width={2400}
              height={1350}
              loading="eager"
              decoding="async"
              class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.02]"
            />
            <div class="absolute inset-0 bg-ink/20 transition-opacity duration-500 group-hover:bg-ink/10"></div>
            <div class="absolute left-1/2 top-1/2 flex h-20 w-20 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full border border-paper/60 bg-ink/40 backdrop-blur transition-all duration-300 group-hover:scale-110 sm:h-24 sm:w-24">
              <svg width="22" height="22" viewBox="0 0 14 14" fill="currentColor" aria-hidden="true">
                <path d="M2 1.5l10 5.5L2 12.5z" />
              </svg>
            </div>
          </div>
        </button>
      </div>

      <!-- Meta strip -->
      <dl class="reveal reveal-d2 mt-14 grid grid-cols-2 gap-x-8 gap-y-8 border-y border-paper/10 py-10 sm:grid-cols-4 sm:py-12">
        <div>
          <dt class="text-[10px] uppercase tracking-[0.25em] text-paper/40">Client</dt>
          <dd class="mt-3 text-base sm:text-lg">{project.client}</dd>
        </div>
        <div>
          <dt class="text-[10px] uppercase tracking-[0.25em] text-paper/40">Role</dt>
          <dd class="mt-3 text-base sm:text-lg">{project.roles.join(' · ')}</dd>
        </div>
        <div>
          <dt class="text-[10px] uppercase tracking-[0.25em] text-paper/40">Format</dt>
          <dd class="mt-3 text-base sm:text-lg">{project.formats.join(' · ')}</dd>
        </div>
        <div>
          <dt class="text-[10px] uppercase tracking-[0.25em] text-paper/40">Year</dt>
          <dd class="mt-3 text-base sm:text-lg">{project.year}</dd>
        </div>
        {project.collaborators && project.collaborators.length > 0 && (
          <div class="sm:col-span-4">
            <dt class="text-[10px] uppercase tracking-[0.25em] text-paper/40">Collaborators</dt>
            <dd class="mt-3 text-base sm:text-lg">{project.collaborators.join(', ')}</dd>
          </div>
        )}
      </dl>

      <!-- Challenge / Approach / Result -->
      <div class="mt-16 grid grid-cols-1 gap-12 md:grid-cols-12 md:gap-16 sm:mt-24">
        {[
          { n: '01', label: 'Challenge', body: project.challenge },
          { n: '02', label: 'Approach', body: project.approach },
          { n: '03', label: 'Result', body: project.result },
        ].map((sec, i) => (
          <section class={`reveal reveal-d${(i % 4) + 1} md:col-span-12`}>
            <div class="grid grid-cols-1 gap-8 md:grid-cols-12">
              <div class="md:col-span-3">
                <p class="text-[10px] uppercase tracking-[0.3em] text-paper/40">
                  {sec.n} — {sec.label}
                </p>
              </div>
              <p class="text-2xl font-light leading-snug tracking-tight text-paper/85 sm:text-3xl md:col-span-9 md:text-4xl">
                {sec.body}
              </p>
            </div>
          </section>
        ))}
      </div>

      <!-- Testimonial -->
      {project.testimonial && (
        <figure class="reveal mt-20 max-w-4xl border-l-2 border-accent pl-6 sm:mt-32 sm:pl-10">
          <blockquote>
            <p class="text-2xl font-light leading-snug sm:text-3xl md:text-4xl">
              "{project.testimonial.quote}"
            </p>
          </blockquote>
          <figcaption class="mt-6 flex items-baseline gap-3 text-sm">
            <span class="text-paper">{project.testimonial.author}</span>
            <span class="text-paper/40">·</span>
            <span class="text-paper/60">{project.testimonial.role}</span>
          </figcaption>
        </figure>
      )}

      <!-- Credits -->
      {project.credits && project.credits.length > 0 && (
        <section class="reveal mt-20 sm:mt-32" aria-label="Credits">
          <p class="text-[10px] uppercase tracking-[0.3em] text-paper/40">Credits</p>
          <dl class="mt-6 grid grid-cols-1 gap-x-8 gap-y-3 sm:grid-cols-2">
            {project.credits.map((c) => (
              <div class="flex items-baseline justify-between gap-6 border-b border-paper/10 py-3">
                <dt class="text-sm text-paper/50">{c.role}</dt>
                <dd class="text-sm text-paper">{c.name}</dd>
              </div>
            ))}
          </dl>
        </section>
      )}

      <!-- Prev / Next -->
      <nav aria-label="Project navigation" class="mt-24 grid grid-cols-2 gap-6 border-t border-paper/10 pt-12 sm:mt-32">
        {prev ? (
          <a href={`/work/${prev.slug}`} class="group block">
            <p class="text-[10px] uppercase tracking-[0.25em] text-paper/40">← Previous</p>
            <p class="mt-2 text-lg font-medium tracking-tight transition group-hover:text-paper/60 sm:text-2xl">{prev.title}</p>
          </a>
        ) : <div></div>}
        {next ? (
          <a href={`/work/${next.slug}`} class="group block text-right">
            <p class="text-[10px] uppercase tracking-[0.25em] text-paper/40">Next →</p>
            <p class="mt-2 text-lg font-medium tracking-tight transition group-hover:text-paper/60 sm:text-2xl">{next.title}</p>
          </a>
        ) : <div></div>}
      </nav>
    </div>
  </article>

  <ContactCTA
    heading="Liked this? Bring me the next one."
    sub="Briefs, half-formed ideas, edit-only jobs, retainers — all welcome."
    index="— Contact"
  />
</BaseLayout>
