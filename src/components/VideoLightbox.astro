---
// Singleton dialog. Include once per page. Trigger with any element bearing
// `data-lightbox-open` + `data-vimeo-id="<id>"`.
---

<dialog
  id="lightbox"
  class="m-0 bg-ink/95 p-0 text-paper backdrop:bg-ink/90"
  aria-label="Video player"
>
  <div class="relative flex h-full w-full items-center justify-center p-4 sm:p-12">
    <button
      type="button"
      data-lightbox-close
      aria-label="Close player"
      class="absolute right-4 top-4 z-10 flex h-11 w-11 items-center justify-center rounded-full border border-paper/30 transition hover:bg-paper hover:text-ink sm:right-6 sm:top-6"
    >
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <path d="M3 3l10 10M13 3L3 13" />
      </svg>
    </button>
    <div class="video-frame w-full max-w-6xl">
      <iframe
        id="lightbox-iframe"
        src=""
        frameborder="0"
        allow="autoplay; fullscreen; picture-in-picture"
        allowfullscreen
        title="Vimeo player"
      ></iframe>
    </div>
  </div>
</dialog>

<script>
  const dialog = document.getElementById('lightbox');
  const iframe = document.getElementById('lightbox-iframe');

  function openLightbox(vimeoId: string) {
    if (!(dialog instanceof HTMLDialogElement) || !(iframe instanceof HTMLIFrameElement)) return;
    const params = '?autoplay=1&dnt=1&title=0&byline=0&portrait=0&badge=0';
    iframe.src = `https://player.vimeo.com/video/${vimeoId}${params}`;
    dialog.showModal();
    document.body.style.overflow = 'hidden';
    window.dispatchEvent(
      new CustomEvent('jw:event', { detail: { name: 'lightbox_open', vimeoId } }),
    );
  }

  function closeLightbox() {
    if (!(dialog instanceof HTMLDialogElement) || !(iframe instanceof HTMLIFrameElement)) return;
    iframe.src = '';
    if (dialog.open) dialog.close();
    document.body.style.overflow = '';
  }

  document.querySelectorAll<HTMLElement>('[data-lightbox-open]').forEach((el) => {
    el.addEventListener('click', (e) => {
      e.preventDefault();
      const id = el.getAttribute('data-vimeo-id');
      if (id) openLightbox(id);
    });
  });

  document.querySelectorAll<HTMLElement>('[data-lightbox-close]').forEach((el) => {
    el.addEventListener('click', closeLightbox);
  });

  if (dialog instanceof HTMLDialogElement) {
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) closeLightbox();
    });
    dialog.addEventListener('cancel', (e) => {
      e.preventDefault();
      closeLightbox();
    });
  }

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && dialog instanceof HTMLDialogElement && dialog.open) {
      closeLightbox();
    }
  });
</script>
