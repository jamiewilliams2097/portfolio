---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';

const title = `Contact — ${site.name}`;
const description = `Get in touch with ${site.name} — ${site.role}, ${site.location}. Briefs, half-formed ideas and edit-only enquiries all welcome.`;
---

<BaseLayout title={title} description={description}>
  <section class="px-6 pb-20 pt-32 sm:px-12 sm:pb-32 sm:pt-40">
    <div class="mx-auto max-w-screen-2xl">
      <div class="reveal">
        <p class="text-[10px] uppercase tracking-[0.3em] text-paper/40">Contact</p>
        <h1 class="mt-4 max-w-5xl text-5xl font-medium leading-[1.02] tracking-[-0.03em] sm:text-7xl md:text-8xl">
          Let&rsquo;s make<br />something good<span class="text-accent">.</span>
        </h1>
        <p class="mt-8 max-w-2xl text-lg font-light text-paper/75 sm:text-xl md:text-2xl">
          Need an editor who can shape the story and ship the cut? Send a brief, a deadline or a half-formed idea — I&rsquo;ll come back with a clear way forward, usually within the working day.
        </p>
      </div>

      <div class="mt-16 grid grid-cols-1 gap-12 md:grid-cols-12 md:gap-16 sm:mt-24">
        <!-- Direct details -->
        <div class="reveal reveal-d1 md:col-span-5">
          <p class="text-[10px] uppercase tracking-[0.25em] text-paper/40">Direct</p>
          <a
            href={`mailto:${site.email}?subject=Project enquiry`}
            class="group mt-6 inline-flex flex-wrap items-baseline gap-3 text-2xl font-medium tracking-tight transition hover:text-paper/60 sm:text-3xl md:text-4xl"
            data-event="cta_email"
          >
            {site.email}
            <svg width="18" height="18" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" class="transition-transform group-hover:translate-x-1">
              <path d="M2 7h10m0 0L8 3m4 4l-4 4" />
            </svg>
          </a>

          <div class="mt-10 space-y-6 text-sm text-paper/70">
            <div>
              <p class="text-[10px] uppercase tracking-[0.25em] text-paper/40">Phone</p>
              <a href={`tel:${site.phone.replace(/\s/g, '')}`} class="mt-2 inline-block text-base transition hover:text-paper sm:text-lg" data-event="cta_phone">
                {site.phone}
              </a>
            </div>
            <div>
              <p class="text-[10px] uppercase tracking-[0.25em] text-paper/40">Based</p>
              <p class="mt-2 text-base text-paper sm:text-lg">{site.location}</p>
              <p class="mt-1 text-sm text-paper/60">{site.availability}</p>
            </div>
            <div>
              <p class="text-[10px] uppercase tracking-[0.25em] text-paper/40">Elsewhere</p>
              <div class="mt-2 flex flex-wrap gap-x-6 gap-y-2 text-base sm:text-lg">
                <a href={site.socials.instagram} target="_blank" rel="noopener" class="transition hover:text-paper">Instagram</a>
                <a href={site.socials.linkedin} target="_blank" rel="noopener" class="transition hover:text-paper">LinkedIn</a>
                <a href={site.socials.vimeo} target="_blank" rel="noopener" class="transition hover:text-paper">Vimeo</a>
              </div>
            </div>
            <div>
              <a
                href={site.cvPdfPath}
                class="inline-flex items-center gap-2 rounded-full border border-paper/30 px-4 py-2 text-sm transition hover:bg-paper hover:text-ink"
                download
                data-event="cv_download"
              >
                Download CV
                <svg width="12" height="12" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                  <path d="M7 2v8m0 0L3 6m4 4l4-4M2 12h10" />
                </svg>
              </a>
            </div>
          </div>
        </div>

        <!-- Brief form (mailto-based; swap to a backend later if needed) -->
        <form
          id="brief-form"
          class="reveal reveal-d2 md:col-span-7"
          aria-label="Project brief"
        >
          <p class="text-[10px] uppercase tracking-[0.25em] text-paper/40">Send a brief</p>
          <p class="mt-3 max-w-md text-sm text-paper/60">
            Quick form — the answers populate an email draft when you hit send. No form backend, no third-party tracking.
          </p>

          <div class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-2">
            <div class="sm:col-span-1">
              <label for="f-name" class="block text-[10px] uppercase tracking-[0.25em] text-paper/40">Name</label>
              <input id="f-name" name="name" type="text" required autocomplete="name" class="mt-2 w-full border-b border-paper/20 bg-transparent py-2 text-base text-paper outline-none transition placeholder:text-paper/30 focus:border-accent" placeholder="Your name" />
            </div>
            <div class="sm:col-span-1">
              <label for="f-email" class="block text-[10px] uppercase tracking-[0.25em] text-paper/40">Email</label>
              <input id="f-email" name="email" type="email" required autocomplete="email" class="mt-2 w-full border-b border-paper/20 bg-transparent py-2 text-base text-paper outline-none transition placeholder:text-paper/30 focus:border-accent" placeholder="you@example.com" />
            </div>
            <div class="sm:col-span-2">
              <label for="f-company" class="block text-[10px] uppercase tracking-[0.25em] text-paper/40">Company / agency <span class="text-paper/30">(optional)</span></label>
              <input id="f-company" name="company" type="text" autocomplete="organization" class="mt-2 w-full border-b border-paper/20 bg-transparent py-2 text-base text-paper outline-none transition placeholder:text-paper/30 focus:border-accent" placeholder="Where you're calling from" />
            </div>
            <div class="sm:col-span-2">
              <label for="f-type" class="block text-[10px] uppercase tracking-[0.25em] text-paper/40">Project type</label>
              <select id="f-type" name="type" class="mt-2 w-full border-b border-paper/20 bg-transparent py-2 text-base text-paper outline-none transition focus:border-accent">
                <option value="Branded campaign" class="bg-ink">Branded campaign</option>
                <option value="Social-first content" class="bg-ink">Social-first content</option>
                <option value="Edit-only" class="bg-ink">Edit-only</option>
                <option value="Documentary" class="bg-ink">Documentary</option>
                <option value="Retainer" class="bg-ink">Retainer</option>
                <option value="Something else" class="bg-ink">Something else</option>
              </select>
            </div>
            <div class="sm:col-span-2">
              <label for="f-brief" class="block text-[10px] uppercase tracking-[0.25em] text-paper/40">The brief</label>
              <textarea id="f-brief" name="brief" rows="5" required class="mt-2 w-full border-b border-paper/20 bg-transparent py-2 text-base text-paper outline-none transition placeholder:text-paper/30 focus:border-accent" placeholder="What are you making, who's it for, when do you need it?"></textarea>
            </div>
          </div>

          <p id="form-error" class="mt-4 hidden text-sm text-accent" role="alert"></p>

          <button
            type="submit"
            class="group mt-10 inline-flex items-center gap-3 rounded-full bg-paper px-6 py-3 text-sm font-medium text-ink transition hover:bg-paper/90"
            data-event="brief_submit"
          >
            Send brief
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">
              <path d="M2 7h10m0 0L8 3m4 4l-4 4" />
            </svg>
          </button>

          <p class="mt-4 text-xs text-paper/40">
            Opens your email client with the brief pre-filled. Prefer to write your own? Email <a href={`mailto:${site.email}`} class="underline">{site.email}</a> direct.
          </p>
        </form>
      </div>
    </div>
  </section>

  <script define:vars={{ email: site.email }}>
    const form = document.getElementById('brief-form');
    const err = document.getElementById('form-error');
    function show(msg) {
      if (!err) return;
      err.textContent = msg;
      err.classList.remove('hidden');
    }
    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      if (!(form instanceof HTMLFormElement)) return;
      const data = new FormData(form);
      const name = (data.get('name') || '').toString().trim();
      const emailFrom = (data.get('email') || '').toString().trim();
      const company = (data.get('company') || '').toString().trim();
      const type = (data.get('type') || '').toString().trim();
      const brief = (data.get('brief') || '').toString().trim();

      if (!name || !emailFrom || !brief) {
        show('Name, email and the brief are needed before sending.');
        return;
      }
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(emailFrom)) {
        show('That email address doesn’t look right — give it another go.');
        return;
      }

      const subject = `Project enquiry — ${type} — ${name}`;
      const body = [
        `Name: ${name}`,
        `Email: ${emailFrom}`,
        company ? `Company: ${company}` : null,
        `Project type: ${type}`,
        '',
        'Brief:',
        brief,
      ]
        .filter(Boolean)
        .join('\n');

      window.location.href =
        `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
    });
  </script>
</BaseLayout>
