---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactCTA from '../components/ContactCTA.astro';
import Marquee from '../components/Marquee.astro';
import { site } from '../data/site';
import { sideProjects, outsideOfWork } from '../data/cv';

const title = `About — ${site.name}`;
const description = `${site.name} is a freelance video editor and shoot director based in ${site.location}. Branded, social and documentary work for agencies and direct clients.`;
---

<BaseLayout title={title} description={description}>
  <section class="px-6 pb-20 pt-32 sm:px-12 sm:pb-32 sm:pt-40">
    <div class="mx-auto max-w-screen-2xl">
      <div class="reveal">
        <p class="text-[10px] uppercase tracking-[0.3em] text-paper/40">About</p>
        <h1 class="mt-4 max-w-5xl text-5xl font-medium leading-[1.02] tracking-[-0.03em] sm:text-7xl md:text-8xl">
          Editor in the suite,<br class="hidden sm:block" />
          director on the day<span class="text-accent">.</span>
        </h1>
      </div>

      <div class="mt-16 grid grid-cols-1 gap-12 md:grid-cols-12 md:gap-16 sm:mt-24">
        <div class="reveal reveal-d1 md:col-span-3">
          <p class="text-[10px] uppercase tracking-[0.25em] text-paper/40">Bio</p>
        </div>
        <div class="md:col-span-9">
          <p class="reveal text-2xl font-light leading-snug tracking-tight sm:text-4xl md:text-5xl">
            I&rsquo;m {site.name} — a video editor and shoot director based in {site.location}.
            At <span class="text-paper">Impress Video</span> I work across 20+ brands —
            healthcare, dental, fitness, lifestyle, charity and digital media — scripting,
            directing, shooting and cutting everything from multi-day campaigns to sub-30-second social.
          </p>
          <p class="reveal reveal-d1 mt-10 max-w-2xl text-base text-paper/65 sm:text-lg">
            Roughly a shoot a week, comfortable on Red Komodo, Blackmagic or Sony, with lighting and sound
            packed in the car. Before that, six years freelance — turning teenage YouTube edits into a paying
            client base, with content reaching hundreds of thousands of views. The freelance years gave me
            the pickup-shot intuition and channel-pacing instinct that still shape every cut.
          </p>
          <p class="reveal reveal-d2 mt-6 max-w-2xl text-base text-paper/65 sm:text-lg">
            I lead Instagram strategy across three pillars — comedy and reach, education, and business
            authority — writing scripts, building shot lists and editing the cuts. Posts have reached
            hundreds of thousands of views. Senior client relationships across the full project lifecycle.
          </p>
        </div>
      </div>
    </div>
  </section>

  <Marquee words={['Premiere Pro', 'After Effects', 'Photoshop', 'Red Komodo', 'Blackmagic', 'Sony', 'Lighting', 'Sound']} />

  <!-- Tools / Cameras / Languages -->
  <section class="border-t border-paper/10 px-6 py-20 sm:px-12 sm:py-32">
    <div class="mx-auto max-w-screen-2xl">
      <div class="grid grid-cols-1 gap-12 md:grid-cols-12 md:gap-16">
        <div class="reveal md:col-span-3">
          <p class="text-[10px] uppercase tracking-[0.25em] text-paper/40">Kit</p>
          <h2 class="mt-4 text-3xl font-medium tracking-tight sm:text-5xl">What I work with.</h2>
        </div>
        <dl class="reveal reveal-d1 grid grid-cols-2 gap-x-8 gap-y-10 md:col-span-9 sm:grid-cols-4">
          <div>
            <dt class="text-[10px] uppercase tracking-[0.25em] text-paper/40">Suite</dt>
            <dd class="mt-3 text-base sm:text-lg">Premiere Pro</dd>
            <dd class="text-base sm:text-lg">After Effects</dd>
            <dd class="text-base sm:text-lg">Photoshop</dd>
          </div>
          <div>
            <dt class="text-[10px] uppercase tracking-[0.25em] text-paper/40">Cameras</dt>
            <dd class="mt-3 text-base sm:text-lg">Red Komodo</dd>
            <dd class="text-base sm:text-lg">Blackmagic</dd>
            <dd class="text-base sm:text-lg">Sony</dd>
          </div>
          <div>
            <dt class="text-[10px] uppercase tracking-[0.25em] text-paper/40">On set</dt>
            <dd class="mt-3 text-base sm:text-lg">Lighting</dd>
            <dd class="text-base sm:text-lg">Sound</dd>
            <dd class="text-base sm:text-lg">Direction</dd>
          </div>
          <div>
            <dt class="text-[10px] uppercase tracking-[0.25em] text-paper/40">Platforms</dt>
            <dd class="mt-3 text-base sm:text-lg">Instagram</dd>
            <dd class="text-base sm:text-lg">LinkedIn</dd>
            <dd class="text-base sm:text-lg">YouTube · TikTok</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <!-- Side projects -->
  <section class="border-t border-paper/10 px-6 py-20 sm:px-12 sm:py-32">
    <div class="mx-auto max-w-screen-2xl">
      <div class="grid grid-cols-1 gap-12 md:grid-cols-12 md:gap-16">
        <div class="reveal md:col-span-3">
          <p class="text-[10px] uppercase tracking-[0.25em] text-paper/40">Side projects</p>
          <h2 class="mt-4 text-3xl font-medium tracking-tight sm:text-5xl">
            Builds for editors.
          </h2>
          <p class="mt-6 max-w-xs text-sm text-paper/60">
            Premiere Pro plugins I&rsquo;ve shipped to fix workflow problems I kept hitting in the suite.
          </p>
        </div>
        <ul class="reveal reveal-d1 grid grid-cols-1 gap-px overflow-hidden rounded-sm bg-paper/10 md:col-span-9">
          {sideProjects.map((s, i) => (
            <li class="bg-ink p-7 sm:p-10">
              <div class="flex items-baseline gap-5">
                <span class="text-xs text-paper/30 tabular-nums">{String(i + 1).padStart(2, '0')}</span>
                <h3 class="text-xl font-medium tracking-tight sm:text-2xl">{s.name}</h3>
              </div>
              <p class="mt-3 max-w-2xl text-sm leading-relaxed text-paper/60 sm:text-base">{s.tagline}</p>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- Outside of work -->
  <section class="border-t border-paper/10 px-6 py-20 sm:px-12 sm:py-32">
    <div class="mx-auto max-w-screen-2xl">
      <div class="grid grid-cols-1 gap-12 md:grid-cols-12 md:gap-16">
        <div class="reveal md:col-span-3">
          <p class="text-[10px] uppercase tracking-[0.25em] text-paper/40">Outside of work</p>
        </div>
        <p class="reveal reveal-d1 max-w-3xl text-2xl font-light leading-snug tracking-tight text-paper/85 md:col-span-9 sm:text-3xl md:text-4xl">
          {outsideOfWork}
        </p>
      </div>
    </div>
  </section>

  <ContactCTA index="— Contact" />
</BaseLayout>
