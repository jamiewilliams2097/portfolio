---
import '../styles/global.css';
import { Image } from 'astro:assets';

type Project = {
  title: string;
  client: string;
  vimeoId: string;
  poster: string;
};

const projects: Project[] = [
  { title: 'Echoes of the City',     client: 'Northbound Records',   vimeoId: '76979871',  poster: 'https://picsum.photos/seed/echoes/1280/720' },
  { title: 'Slow Light',             client: 'Halcyon Brewing',      vimeoId: '169599296', poster: 'https://picsum.photos/seed/slow/1280/720' },
  { title: 'A Field, Untitled',      client: 'Field Notes Magazine', vimeoId: '22439234',  poster: 'https://picsum.photos/seed/field/1280/720' },
  { title: 'Northwind',              client: 'Atlas Outdoor',        vimeoId: '195411155', poster: 'https://picsum.photos/seed/north/1280/720' },
  { title: 'Hands & Pages',          client: 'Tessera Studios',      vimeoId: '254823010', poster: 'https://picsum.photos/seed/hands/1280/720' },
  { title: 'The First Pour',         client: 'Cumulus Coffee',       vimeoId: '158918409', poster: 'https://picsum.photos/seed/pour/1280/720' },
  { title: 'Backroads',              client: 'Polaris Cycles',       vimeoId: '124368205', poster: 'https://picsum.photos/seed/back/1280/720' },
  { title: 'Cut & Fold',             client: 'Anvil Apparel',        vimeoId: '1084537',   poster: 'https://picsum.photos/seed/cut/1280/720' },
  { title: 'Quiet Rooms',            client: 'Lumen & Co.',          vimeoId: '147416790', poster: 'https://picsum.photos/seed/quiet/1280/720' },
];

const clients = [
  'Northbound Records',
  'Halcyon Brewing',
  'Field Notes Magazine',
  'Atlas Outdoor',
  'Tessera Studios',
  'Cumulus Coffee',
  'Polaris Cycles',
  'Anvil Apparel',
  'Lumen & Co.',
];

const name = 'Jamie [Surname]';
const role = 'Videographer & Editor — Derby, UK';
const email = 'hello@example.com';
const showreelVimeoId = '76979871';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="description" content={`${name} — ${role}. Selected work.`} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <title>{name} — {role}</title>
  </head>
  <body class="bg-ink text-paper">
    <!-- HERO -->
    <section id="hero" class="relative h-screen w-full overflow-hidden">
      <video
        class="absolute inset-0 h-full w-full object-cover"
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        poster="/showreel-poster.svg"
        aria-hidden="true"
      >
        <source src="/showreel.webm" type="video/webm" />
        <source src="/showreel.mp4" type="video/mp4" />
      </video>
      <div class="absolute inset-0 bg-black/55" aria-hidden="true"></div>

      <div class="relative z-10 mx-auto flex h-full w-full max-w-screen-2xl flex-col items-start justify-end px-6 pb-16 sm:px-12 sm:pb-24">
        <h1 class="text-5xl font-medium tracking-tight sm:text-7xl md:text-8xl">{name}</h1>
        <p class="mt-4 text-lg text-paper/80 sm:text-xl">{role}</p>
        <button
          type="button"
          data-lightbox-open
          data-vimeo-id={showreelVimeoId}
          class="mt-8 inline-flex items-center gap-3 rounded-full border border-paper/30 px-5 py-2.5 text-sm transition hover:bg-paper hover:text-ink"
        >
          <svg width="12" height="12" viewBox="0 0 14 14" fill="currentColor" aria-hidden="true">
            <path d="M2 1.5l10 5.5L2 12.5z" />
          </svg>
          Play showreel
        </button>
      </div>
    </section>

    <!-- ABOUT -->
    <section id="about" class="reveal px-6 py-32 sm:px-12 sm:py-48">
      <div class="mx-auto max-w-3xl">
        <p class="text-2xl leading-snug tracking-tight sm:text-4xl">
          I'm {name}, a videographer and editor based in <span class="text-paper/60">Derby, UK</span>. I make short films, brand documentaries, and music videos that lean on natural light and patient pacing. Available worldwide for commissions, residencies, and collaboration.
        </p>
      </div>
    </section>

    <!-- WORK GRID -->
    <section id="work" class="reveal px-6 pb-32 sm:px-12">
      <div class="mx-auto max-w-screen-2xl">
        <h2 class="mb-8 text-xs uppercase tracking-[0.25em] text-paper/50">Selected work</h2>
        <ul class="grid grid-cols-1 gap-6 sm:grid-cols-2 sm:gap-8 lg:grid-cols-3">
          {projects.map((p) => (
            <li>
              <button
                type="button"
                data-lightbox-open
                data-vimeo-id={p.vimeoId}
                class="group block w-full text-left"
                aria-label={`Play ${p.title} for ${p.client}`}
              >
                <div class="aspect-video overflow-hidden rounded bg-paper/5">
                  <Image
                    src={p.poster}
                    alt={`${p.title} — ${p.client}`}
                    width={1280}
                    height={720}
                    loading="lazy"
                    decoding="async"
                    class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.02]"
                  />
                </div>
                <div class="mt-3 flex items-baseline justify-between gap-4">
                  <span class="text-base sm:text-lg">{p.title}</span>
                  <span class="truncate text-xs text-paper/50 sm:text-sm">{p.client}</span>
                </div>
              </button>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- CLIENTS -->
    <section id="clients" class="reveal border-t border-paper/10 px-6 py-32 sm:px-12">
      <div class="mx-auto max-w-screen-2xl">
        <h2 class="mb-8 text-xs uppercase tracking-[0.25em] text-paper/50">Selected clients</h2>
        <ul class="flex flex-wrap gap-x-8 gap-y-3 text-base text-paper/50 sm:text-lg">
          {clients.map((c) => <li>{c}</li>)}
        </ul>
      </div>
    </section>

    <!-- CONTACT -->
    <section id="contact" class="reveal border-t border-paper/10 px-6 py-32 sm:px-12 sm:py-48">
      <div class="mx-auto max-w-3xl">
        <h2 class="mb-8 text-xs uppercase tracking-[0.25em] text-paper/50">Get in touch</h2>
        <a
          href={`mailto:${email}`}
          class="block text-3xl tracking-tight transition hover:text-paper/60 sm:text-5xl md:text-6xl"
        >
          {email}
        </a>
        <ul class="mt-12 flex flex-wrap gap-x-8 gap-y-3 text-sm text-paper/50">
          <li><a href="https://www.instagram.com/" target="_blank" rel="noopener" class="transition hover:text-paper">Instagram</a></li>
          <li><a href="https://www.linkedin.com/" target="_blank" rel="noopener" class="transition hover:text-paper">LinkedIn</a></li>
          <li><a href="https://vimeo.com/" target="_blank" rel="noopener" class="transition hover:text-paper">Vimeo</a></li>
        </ul>
        <p class="mt-16 text-xs text-paper/30">© {new Date().getFullYear()} {name}</p>
      </div>
    </section>

    <!-- LIGHTBOX -->
    <dialog
      id="lightbox"
      class="m-0 bg-black/95 p-0 text-paper backdrop:bg-black/95"
      aria-label="Video player"
    >
      <div class="relative flex h-full w-full items-center justify-center p-4 sm:p-12">
        <button
          type="button"
          data-lightbox-close
          aria-label="Close"
          class="absolute right-4 top-4 z-10 flex h-10 w-10 items-center justify-center rounded-full border border-paper/30 transition hover:bg-paper hover:text-ink sm:right-6 sm:top-6"
        >
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path d="M3 3l10 10M13 3L3 13" />
          </svg>
        </button>
        <div class="aspect-video w-full max-w-6xl">
          <iframe
            id="lightbox-iframe"
            class="h-full w-full"
            src=""
            frameborder="0"
            allow="autoplay; fullscreen; picture-in-picture"
            allowfullscreen
            title="Vimeo video"
          ></iframe>
        </div>
      </div>
    </dialog>

    <script>
      const dialog = document.getElementById('lightbox');
      const iframe = document.getElementById('lightbox-iframe');

      function openLightbox(vimeoId) {
        if (!(dialog instanceof HTMLDialogElement) || !(iframe instanceof HTMLIFrameElement)) return;
        const params = '?autoplay=1&dnt=1&title=0&byline=0&portrait=0&badge=0';
        iframe.src = `https://player.vimeo.com/video/${vimeoId}${params}`;
        dialog.showModal();
        document.body.style.overflow = 'hidden';
      }

      function closeLightbox() {
        if (!(dialog instanceof HTMLDialogElement) || !(iframe instanceof HTMLIFrameElement)) return;
        iframe.src = '';
        if (dialog.open) dialog.close();
        document.body.style.overflow = '';
      }

      document.querySelectorAll('[data-lightbox-open]').forEach((el) => {
        el.addEventListener('click', () => {
          const id = el.getAttribute('data-vimeo-id');
          if (id) openLightbox(id);
        });
      });

      document.querySelectorAll('[data-lightbox-close]').forEach((el) => {
        el.addEventListener('click', closeLightbox);
      });

      if (dialog instanceof HTMLDialogElement) {
        dialog.addEventListener('click', (e) => {
          if (e.target === dialog) closeLightbox();
        });
        dialog.addEventListener('cancel', (e) => {
          e.preventDefault();
          closeLightbox();
        });
      }

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && dialog instanceof HTMLDialogElement && dialog.open) {
          closeLightbox();
        }
      });

      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('in');
                io.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.12 },
        );
        document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
      } else {
        document.querySelectorAll('.reveal').forEach((el) => el.classList.add('in'));
      }
    </script>
  </body>
</html>
