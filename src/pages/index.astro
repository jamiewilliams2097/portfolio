---
import '../styles/global.css';
import { Image } from 'astro:assets';

type Project = {
  title: string;
  client: string;
  tag: string;
  year: string;
  blurb: string;
  vimeoId: string;
  poster: string;
};

// TODO: replace each entry's vimeoId, poster and blurb with the real ones once shots are cut.
const projects: Project[] = [
  {
    title: 'ALD Flex UK',
    client: 'Automotive · LinkedIn social',
    tag: 'Automotive',
    year: '2025',
    blurb:
      'LinkedIn-led vehicle content for ALD Flex UK — short, sharp social pieces built for reach with fleet decision-makers.',
    vimeoId: '76979871',
    poster: 'https://picsum.photos/seed/aldflex/1600/900',
  },
  {
    title: 'Impress Video — Brand campaigns',
    client: 'Healthcare · Dental · Lifestyle',
    tag: 'Commercial',
    year: '2022 — Present',
    blurb:
      'Ongoing campaign and social-first work across 20+ brands at Impress Video. Multi-day shoots through to sub-30-second cutdowns.',
    vimeoId: '169599296',
    poster: 'https://picsum.photos/seed/impress/1600/900',
  },
  {
    title: 'Social-first cutdowns',
    client: 'Instagram · LinkedIn · TikTok',
    tag: 'Social',
    year: 'Ongoing',
    blurb:
      'Caption-led short-form: presenter pieces, music-synced comedy and educational cuts engineered for hold-and-rewatch.',
    vimeoId: '195411155',
    poster: 'https://picsum.photos/seed/social/1600/900',
  },
  {
    title: 'Freelance — end-to-end',
    client: 'Creators · Small business',
    tag: 'Production',
    year: '2016 — Present',
    blurb:
      'Freelance videography for creators and small businesses — from brief and shoot through edit and delivery. Content pulling 200k+ views.',
    vimeoId: '22439234',
    poster: 'https://picsum.photos/seed/freelance/1600/900',
  },
];

const services = [
  'Filming',
  'Editing',
  'Social-first cutdowns',
  'Branded content',
  'Automotive content',
  'Motion & caption-led edits',
  'Client-ready delivery',
];

const marqueeWords = [
  'Brand',
  'Social',
  'Automotive',
  'Commercial',
  'Shoot',
  'Edit',
  'Deliver',
];

const name = 'Jamie Williams';
const role = 'Video Editor & Shoot Director';
const location = 'Derbyshire, UK';

// TODO: swap to a branded address (e.g. hello@jamiewilliams.video) once configured.
const email = 'jamiewilliams2097@gmail.com';
const phone = '07870 716816';

// TODO: replace with the live Vimeo showreel ID.
const showreelVimeoId = '76979871';

// TODO: replace with real profile URLs.
const socials = {
  instagram: 'https://www.instagram.com/',
  linkedin: 'https://www.linkedin.com/',
  vimeo: 'https://vimeo.com/',
};

const description = `${name} — ${role}. Practical, polished video for brands, agencies and automotive. Based in ${location}.`;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="description" content={description} />
    <meta property="og:title" content={`${name} — ${role}`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&display=swap"
    />
    <title>{name} — {role}</title>
  </head>
  <body class="bg-ink text-paper">
    <a
      href="#work"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:bg-paper focus:px-3 focus:py-2 focus:text-sm focus:text-ink"
    >
      Skip to work
    </a>

    <!-- NAV -->
    <header
      id="site-nav"
      class="fixed inset-x-0 top-0 z-40 transition-all duration-300"
    >
      <div class="mx-auto flex max-w-screen-2xl items-center justify-between px-6 py-4 sm:px-12">
        <a href="#hero" class="flex items-baseline gap-2 text-sm font-medium tracking-tight">
          <span>Jamie Williams</span>
          <span class="hidden text-paper/40 sm:inline">— {role}</span>
        </a>
        <nav aria-label="Primary" class="hidden gap-8 text-sm text-paper/70 md:flex">
          <a href="#work" class="transition hover:text-paper">Work</a>
          <a href="#services" class="transition hover:text-paper">What I do</a>
          <a href="#about" class="transition hover:text-paper">About</a>
          <a href="#contact" class="transition hover:text-paper">Contact</a>
        </nav>
        <a
          href="#contact"
          class="rounded-full border border-paper/30 px-4 py-1.5 text-xs transition hover:bg-paper hover:text-ink sm:text-sm"
        >
          Start a project
        </a>
      </div>
    </header>

    <main>
      <!-- HERO -->
      <section id="hero" class="relative h-[100svh] min-h-[640px] w-full overflow-hidden">
        <div class="absolute inset-0 hero-zoom">
          <video
            class="h-full w-full object-cover"
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
            poster="/showreel-poster.svg"
            aria-hidden="true"
          >
            <!-- TODO: drop in showreel.webm and showreel.mp4 (muted, <15s loop, <1MB each) -->
            <source src="/showreel.webm" type="video/webm" />
            <source src="/showreel.mp4" type="video/mp4" />
          </video>
        </div>
        <div class="absolute inset-0 bg-ink/50" aria-hidden="true"></div>
        <div
          class="absolute inset-x-0 bottom-0 h-2/3 bg-gradient-to-t from-ink via-ink/70 to-transparent"
          aria-hidden="true"
        ></div>

        <div class="relative z-10 mx-auto flex h-full w-full max-w-screen-2xl flex-col justify-end px-6 pb-16 sm:px-12 sm:pb-24">
          <div class="flex items-center gap-3 text-[10px] uppercase tracking-[0.3em] text-paper/60 sm:text-xs">
            <span class="h-px w-10 bg-paper/40"></span>
            <span>Derbyshire · Available now</span>
          </div>
          <h1 class="mt-6 text-6xl font-medium leading-[0.95] tracking-tight sm:text-8xl md:text-9xl">
            Jamie<br />Williams<span class="text-paper/40">.</span>
          </h1>
          <p class="mt-6 max-w-2xl text-lg font-light text-paper/80 sm:text-xl md:text-2xl">
            Video editor and shoot director making practical, polished work for brands, agencies and automotive — from concept to delivery.
          </p>
          <div class="mt-10 flex flex-wrap items-center gap-3">
            <a
              href="#work"
              class="group inline-flex items-center gap-3 rounded-full bg-paper px-6 py-3 text-sm font-medium text-ink transition hover:bg-paper/90"
            >
              View selected work
              <svg
                width="14"
                height="14"
                viewBox="0 0 14 14"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                aria-hidden="true"
                class="transition-transform group-hover:translate-x-0.5"
              >
                <path d="M2 7h10m0 0L8 3m4 4l-4 4" />
              </svg>
            </a>
            <a
              href="#contact"
              class="inline-flex items-center gap-3 rounded-full border border-paper/30 px-6 py-3 text-sm transition hover:bg-paper hover:text-ink"
            >
              Get in touch
            </a>
            <button
              type="button"
              data-lightbox-open
              data-vimeo-id={showreelVimeoId}
              class="group inline-flex items-center gap-2 rounded-full px-3 py-3 text-sm text-paper/70 transition hover:text-paper"
              aria-label="Play the full showreel"
            >
              <span class="flex h-7 w-7 items-center justify-center rounded-full border border-paper/30 transition group-hover:border-paper">
                <svg width="9" height="9" viewBox="0 0 14 14" fill="currentColor" aria-hidden="true">
                  <path d="M2 1.5l10 5.5L2 12.5z" />
                </svg>
              </span>
              Showreel
            </button>
          </div>
        </div>

        <div class="absolute bottom-6 right-6 z-10 hidden items-center gap-2 text-[10px] uppercase tracking-[0.3em] text-paper/40 sm:right-12 sm:flex">
          <span>Scroll</span>
          <svg width="10" height="14" viewBox="0 0 10 14" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true">
            <path d="M5 1v11m0 0L1 8m4 4l4-4" />
          </svg>
        </div>
      </section>

      <!-- MARQUEE -->
      <div class="marquee border-y border-paper/10 py-6 sm:py-8" aria-hidden="true">
        <div class="marquee-track">
          {[0, 1].map((set) => (
            marqueeWords.map((word) => (
              <span class="marquee-item" aria-hidden={set === 1 ? 'true' : undefined}>
                {word}
                <span aria-hidden="true">·</span>
              </span>
            ))
          ))}
        </div>
      </div>

      <!-- WORK -->
      <section id="work" class="px-6 py-28 sm:px-12 sm:py-40">
        <div class="mx-auto max-w-screen-2xl">
          <div class="reveal mb-12 flex flex-col gap-4 sm:mb-20 sm:flex-row sm:items-end sm:justify-between">
            <div>
              <p class="text-[10px] uppercase tracking-[0.3em] text-paper/40">01 — Selected work</p>
              <h2 class="mt-4 text-4xl font-medium tracking-tight sm:text-6xl md:text-7xl">
                Recent work,<br class="hidden sm:block" /> recent clients.
              </h2>
            </div>
            <p class="max-w-xs text-sm text-paper/60">
              Brand, social and automotive — a sample of campaign and freelance work. Click a tile to play.
            </p>
          </div>

          <ul class="grid grid-cols-1 gap-10 md:grid-cols-2 md:gap-x-10 md:gap-y-20">
            {projects.map((p, i) => (
              <li class={`reveal reveal-d${(i % 4) + 1}`}>
                <button
                  type="button"
                  data-lightbox-open
                  data-vimeo-id={p.vimeoId}
                  class="group block w-full text-left"
                  aria-label={`Play ${p.title} — ${p.client}`}
                >
                  <div class="relative aspect-video overflow-hidden rounded-sm bg-paper/5">
                    <Image
                      src={p.poster}
                      alt={`${p.title} — ${p.client}`}
                      width={1600}
                      height={900}
                      loading={i < 2 ? 'eager' : 'lazy'}
                      decoding="async"
                      class="absolute inset-0 h-full w-full object-cover transition duration-[900ms] ease-out group-hover:scale-[1.04]"
                    />
                    <div class="absolute inset-0 bg-ink/20 transition-opacity duration-500 group-hover:bg-ink/10"></div>
                    <div class="absolute left-4 top-4 flex items-center gap-2 text-[10px] uppercase tracking-[0.2em] text-paper/80">
                      <span class="rounded-full border border-paper/30 bg-ink/40 px-2.5 py-1 backdrop-blur">{p.year}</span>
                      <span class="rounded-full border border-paper/30 bg-ink/40 px-2.5 py-1 backdrop-blur">{p.tag}</span>
                    </div>
                    <div class="absolute bottom-4 right-4 flex h-12 w-12 translate-y-2 items-center justify-center rounded-full border border-paper/40 bg-ink/50 opacity-0 backdrop-blur transition-all duration-500 group-hover:translate-y-0 group-hover:opacity-100 sm:h-14 sm:w-14">
                      <svg width="14" height="14" viewBox="0 0 14 14" fill="currentColor" aria-hidden="true">
                        <path d="M2 1.5l10 5.5L2 12.5z" />
                      </svg>
                    </div>
                  </div>
                  <div class="mt-6 flex items-baseline justify-between gap-6">
                    <h3 class="text-xl font-medium tracking-tight sm:text-2xl">{p.title}</h3>
                    <span class="shrink-0 text-xs text-paper/40 tabular-nums">{p.year}</span>
                  </div>
                  <p class="mt-1 text-sm text-paper/60">{p.client}</p>
                  <p class="mt-4 max-w-md text-sm leading-relaxed text-paper/70">{p.blurb}</p>
                </button>
              </li>
            ))}
          </ul>

          <p class="reveal mt-16 max-w-md text-sm text-paper/40 sm:mt-24">
            More on request — case studies, raw masters and turnaround examples available for serious enquiries.
          </p>
        </div>
      </section>

      <!-- SERVICES -->
      <section id="services" class="border-t border-paper/10 px-6 py-28 sm:px-12 sm:py-40">
        <div class="mx-auto max-w-screen-2xl">
          <div class="grid grid-cols-1 gap-12 md:grid-cols-12 md:gap-16">
            <div class="reveal md:col-span-5">
              <p class="text-[10px] uppercase tracking-[0.3em] text-paper/40">02 — What I do</p>
              <h2 class="mt-4 text-4xl font-medium tracking-tight sm:text-6xl">
                Shoot, cut and deliver. End to end.
              </h2>
              <p class="mt-8 max-w-md text-paper/60">
                One week on set with a Red Komodo, the next deep in Premiere. Built for businesses, agencies and branded content teams that need both halves of the job done well.
              </p>
            </div>
            <ul class="reveal reveal-d1 grid grid-cols-1 gap-px overflow-hidden rounded-sm bg-paper/10 sm:grid-cols-2 md:col-span-7">
              {services.map((s, i) => (
                <li class="group flex items-baseline gap-5 bg-ink px-5 py-7 transition hover:bg-paper/[0.03] sm:px-7 sm:py-9">
                  <span class="text-xs text-paper/30 tabular-nums">{String(i + 1).padStart(2, '0')}</span>
                  <span class="text-lg font-medium tracking-tight sm:text-xl">{s}</span>
                </li>
              ))}
              <li class="flex items-baseline gap-5 bg-ink px-5 py-7 sm:px-7 sm:py-9">
                <span class="text-xs text-paper/30 tabular-nums">08</span>
                <span class="text-sm text-paper/40">— and the rest of the brief.</span>
              </li>
            </ul>
          </div>
        </div>
      </section>

      <!-- ABOUT -->
      <section id="about" class="border-t border-paper/10 px-6 py-28 sm:px-12 sm:py-40">
        <div class="mx-auto grid max-w-screen-2xl grid-cols-1 gap-12 md:grid-cols-12 md:gap-16">
          <div class="reveal md:col-span-3">
            <p class="text-[10px] uppercase tracking-[0.3em] text-paper/40">03 — About</p>
          </div>
          <div class="md:col-span-9">
            <p class="reveal text-3xl font-light leading-snug tracking-tight sm:text-5xl md:text-6xl">
              I&rsquo;m a video editor and shoot director based in Derbyshire. With <span class="text-paper">Impress Video</span> I work across 20+ brands — healthcare, dental, fitness, lifestyle, charity and digital media — scripting, directing, shooting and cutting everything from multi-day campaigns to sub-30-second social.
            </p>
            <p class="reveal reveal-d1 mt-10 max-w-2xl text-base text-paper/60 sm:text-lg">
              Roughly a shoot a week, comfortable on Red Komodo, Blackmagic or Sony, with lighting and sound packed in the car. Before that, six years freelance — turning teenage YouTube edits into a paying client base, with content reaching hundreds of thousands of views. On the side I build commercial Premiere Pro plugins — <span class="text-paper">GimbalGuard</span> and <span class="text-paper">ClipSync</span> — that fix real workflow problems.
            </p>

            <dl class="reveal reveal-d2 mt-14 grid grid-cols-2 gap-x-8 gap-y-8 border-t border-paper/10 pt-10 sm:grid-cols-4">
              <div>
                <dt class="text-[10px] uppercase tracking-[0.25em] text-paper/40">Based</dt>
                <dd class="mt-3 text-base sm:text-lg">Derbyshire, UK</dd>
              </div>
              <div>
                <dt class="text-[10px] uppercase tracking-[0.25em] text-paper/40">Tools</dt>
                <dd class="mt-3 text-base sm:text-lg">Premiere · After Effects · Photoshop</dd>
              </div>
              <div>
                <dt class="text-[10px] uppercase tracking-[0.25em] text-paper/40">Cameras</dt>
                <dd class="mt-3 text-base sm:text-lg">Red Komodo · Blackmagic · Sony</dd>
              </div>
              <div>
                <dt class="text-[10px] uppercase tracking-[0.25em] text-paper/40">Working since</dt>
                <dd class="mt-3 text-base sm:text-lg">2016</dd>
              </div>
            </dl>
          </div>
        </div>
      </section>

      <!-- CONTACT -->
      <section id="contact" class="border-t border-paper/10 px-6 py-28 sm:px-12 sm:py-48">
        <div class="mx-auto max-w-screen-2xl">
          <div class="grid grid-cols-1 gap-12 md:grid-cols-12 md:gap-16">
            <div class="reveal md:col-span-3">
              <p class="text-[10px] uppercase tracking-[0.3em] text-paper/40">04 — Contact</p>
            </div>
            <div class="md:col-span-9">
              <h2 class="reveal text-4xl font-medium tracking-tight sm:text-6xl md:text-7xl">
                Let&rsquo;s make<br />something good.
              </h2>
              <p class="reveal reveal-d1 mt-8 max-w-xl text-paper/60 sm:text-lg">
                Available for full project briefs, social-first shoots, edit-only work and ongoing retainers. UK-wide, based in Derbyshire.
              </p>

              <a
                href={`mailto:${email}?subject=Project enquiry`}
                class="reveal reveal-d2 mt-14 inline-flex flex-wrap items-baseline gap-3 text-2xl font-medium tracking-tight transition hover:text-paper/60 sm:text-4xl md:text-5xl"
              >
                {email}
                <svg
                  width="18"
                  height="18"
                  viewBox="0 0 14 14"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  aria-hidden="true"
                  class="translate-y-0 transition-transform group-hover:translate-x-1"
                >
                  <path d="M2 7h10m0 0L8 3m4 4l-4 4" />
                </svg>
              </a>

              <div class="reveal reveal-d3 mt-10 flex flex-wrap items-center gap-x-8 gap-y-3 text-sm text-paper/60">
                <a href={`tel:${phone.replace(/\s/g, '')}`} class="transition hover:text-paper">{phone}</a>
                <span class="text-paper/20" aria-hidden="true">/</span>
                <a href={socials.instagram} target="_blank" rel="noopener" class="transition hover:text-paper">Instagram</a>
                <a href={socials.linkedin} target="_blank" rel="noopener" class="transition hover:text-paper">LinkedIn</a>
                <a href={socials.vimeo} target="_blank" rel="noopener" class="transition hover:text-paper">Vimeo</a>
              </div>
            </div>
          </div>
        </div>
      </section>
    </main>

    <footer class="border-t border-paper/10 px-6 py-10 sm:px-12">
      <div class="mx-auto flex max-w-screen-2xl flex-wrap items-center justify-between gap-4 text-[11px] uppercase tracking-[0.2em] text-paper/40">
        <p>© {new Date().getFullYear()} {name}</p>
        <p>Built with Astro · Hosted on Cloudflare Pages</p>
      </div>
    </footer>

    <!-- LIGHTBOX -->
    <dialog
      id="lightbox"
      class="m-0 bg-ink/95 p-0 text-paper backdrop:bg-ink/90"
      aria-label="Video player"
    >
      <div class="relative flex h-full w-full items-center justify-center p-4 sm:p-12">
        <button
          type="button"
          data-lightbox-close
          aria-label="Close player"
          class="absolute right-4 top-4 z-10 flex h-11 w-11 items-center justify-center rounded-full border border-paper/30 transition hover:bg-paper hover:text-ink sm:right-6 sm:top-6"
        >
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path d="M3 3l10 10M13 3L3 13" />
          </svg>
        </button>
        <div class="aspect-video w-full max-w-6xl">
          <iframe
            id="lightbox-iframe"
            class="h-full w-full"
            src=""
            frameborder="0"
            allow="autoplay; fullscreen; picture-in-picture"
            allowfullscreen
            title="Vimeo player"
          ></iframe>
        </div>
      </div>
    </dialog>

    <script>
      const nav = document.getElementById('site-nav');
      const dialog = document.getElementById('lightbox');
      const iframe = document.getElementById('lightbox-iframe');

      function onScroll() {
        if (!nav) return;
        if (window.scrollY > 16) nav.classList.add('nav-scrolled');
        else nav.classList.remove('nav-scrolled');
      }
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();

      function openLightbox(vimeoId) {
        if (!(dialog instanceof HTMLDialogElement) || !(iframe instanceof HTMLIFrameElement)) return;
        const params = '?autoplay=1&dnt=1&title=0&byline=0&portrait=0&badge=0';
        iframe.src = `https://player.vimeo.com/video/${vimeoId}${params}`;
        dialog.showModal();
        document.body.style.overflow = 'hidden';
      }

      function closeLightbox() {
        if (!(dialog instanceof HTMLDialogElement) || !(iframe instanceof HTMLIFrameElement)) return;
        iframe.src = '';
        if (dialog.open) dialog.close();
        document.body.style.overflow = '';
      }

      document.querySelectorAll('[data-lightbox-open]').forEach((el) => {
        el.addEventListener('click', () => {
          const id = el.getAttribute('data-vimeo-id');
          if (id) openLightbox(id);
        });
      });
      document.querySelectorAll('[data-lightbox-close]').forEach((el) => {
        el.addEventListener('click', closeLightbox);
      });
      if (dialog instanceof HTMLDialogElement) {
        dialog.addEventListener('click', (e) => {
          if (e.target === dialog) closeLightbox();
        });
        dialog.addEventListener('cancel', (e) => {
          e.preventDefault();
          closeLightbox();
        });
      }
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && dialog instanceof HTMLDialogElement && dialog.open) {
          closeLightbox();
        }
      });

      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('in');
                io.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.12, rootMargin: '0px 0px -8% 0px' },
        );
        document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
      } else {
        document.querySelectorAll('.reveal').forEach((el) => el.classList.add('in'));
      }
    </script>
  </body>
</html>
